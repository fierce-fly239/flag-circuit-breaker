# Copy this file to .env and fill in the values. Never commit .env.

# Flagsmith address (self-hosted in Docker)
FLAGSMITH_URL=http://localhost:8000

# Environment key: lets the demo app READ flags (Flagsmith > Environment > SDK keys)
FLAGSMITH_ENV_KEY=

# Admin API key: lets the breaker SWITCH a flag off (Organisation settings > API Keys)
FLAGSMITH_ADMIN_KEY=

# Demo shop settings
# Errors are counted over the last WINDOW_SECONDS seconds
WINDOW_SECONDS=10
# How often the NEW checkout fails (0.5 = half the time)
NEW_CHECKOUT_FAIL_RATE=0.5

# Breaker settings
SHOP_URL=http://localhost:8080
FLAG_NAME=new_checkout
# How often the breaker reads /metrics
CHECK_EVERY_SECONDS=2
# Trip when the error rate goes over this (0.3 = 30%)
ERROR_THRESHOLD=0.3
# Ignore the rate until the window has at least this many requests
MIN_REQUESTS=10
# Only trip within this many seconds after the flag was switched on
WATCH_SECONDS=120
